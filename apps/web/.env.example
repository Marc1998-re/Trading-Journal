# Node/MySQL is the default. Serve frontend and API at the same origin.
VITE_DATA_BACKEND=mysql
VITE_API_URL=/api
# Temporary rollback to PocketBase/Horizons: VITE_DATA_BACKEND=pocketbase
# Leave the URL unset on Horizons to use its /hcgi/platform proxy.
VITE_POCKETBASE_URL=

# Optional, disabled by default. Never tracks authentication or journal pages.
VITE_GA_MEASUREMENT_ID=

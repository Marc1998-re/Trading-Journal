NODE_ENV=development
HOST=127.0.0.1
PORT=4190
APP_URL=http://127.0.0.1:4189
# Set to 1 only when the app is behind one trusted reverse proxy (Hostinger).
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trading_desk
DB_USER=trading_desk
DB_PASSWORD=
DB_POOL_SIZE=5
# Optional remote database TLS. Do not disable certificate validation.
DB_SSL=false
DB_SSL_CA_FILE=
# SMTP credentials belong only on the server, never in VITE_* variables.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=true
